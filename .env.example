# Copy to .env.local for local development.
# Leave the Supabase values empty to use the in-memory local store (dev only).
# On Vercel, the Supabase Marketplace integration sets these for you.

# Public: safe in the browser (read-only via row-level security, used for Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects call it the publishable key; either name works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: never prefix these with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Newer name for the same thing; either works.
# SUPABASE_SECRET_KEY=

# Required, even locally. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=change-me-dev-admin-key
